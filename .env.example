# StreamFusion Studio — variables de entorno
# Copia este archivo a `.env` y completa solo lo que necesites.
# NUNCA subas `.env` al repositorio (ya está en .gitignore).

# Puerto HTTP del servidor
PORT=3000

# Euler Stream Community
EULER_API_KEY=

# Fish Audio (bot de voz)
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_VOICE_VERITY=
FISH_AUDIO_VOICE_NARUTO=
# Opcional: WebSocket del cambiador de voz
FISH_AUDIO_VOICE_CHANGER_WS=

# ------------------------------------------------------------------
# Kick: TODO OPCIONAL. Kick funciona sin OAuth leyendo su realtime
# público (chat + eventos del canal). Estas variables solo sirven para
# los webhooks oficiales, que aportan los follows individuales.
# ------------------------------------------------------------------
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_WEBHOOK_ENABLED=true
KICK_PUBLIC_BASE_URL=
KICK_OAUTH_REDIRECT_URI=
KICK_WEBHOOK_URL=

# Ajustes del realtime público de Kick (opcional)
# KICK_PUSHER_URL=wss://ws-us2.pusher.com/app/32cbd69e4b950bf97679?protocol=7&client=js&version=8.4.0-rc2&flash=false
# KICK_PUSHER_VERSION=8.4.0-rc2
# KICK_RESUBSCRIBE_INTERVAL_MS=45000

# Pruebas locales (opcional)
# FAKE_KICK_PORT=4599
# E2E_PORT=4611
